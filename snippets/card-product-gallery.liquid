<!-- Swiper -->
<div class="swiper card-product-media-swiper">
  <div class="swiper-wrapper">
    {%- for media in product.media limit: 4 -%}
      <div class="swiper-slide">
        <img
          src="{{ media.preview_image | image_url: width: 800 }}"
          alt="{{ media.alt | escape }}"
          class="card__media-gallery-item"
          width="auto"
          height="auto"
        >
      </div>
    {%- endfor -%}
  </div>

  <!-- Navigation -->
  <div class="swiper-button-next">
    <svg
      width="24px"
      height="24px"
      viewBox="0 0 1024 1024"
      class="icon"
      version="1.1"
      xmlns="http://www.w3.org/2000/svg"
      fill="#000000"
    >
      <g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"><path d="M256 120.768L306.432 64 768 512l-461.568 448L256 903.232 659.072 512z" fill="#000000"></path></g>
    </svg>
  </div>
  <div class="swiper-button-prev">
    <svg
      width="24px"
      height="24px"
      viewBox="0 0 1024 1024"
      class="icon"
      version="1.1"
      xmlns="http://www.w3.org/2000/svg"
      fill="#000000"
    >
      <g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"><path d="M768 903.232l-50.432 56.768L256 512l461.568-448 50.432 56.768L364.928 512z" fill="#000000"></path></g>
    </svg>
  </div>
</div>
