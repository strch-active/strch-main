<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">

<style>
  .product-grid-view {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .product-swiper {
    display: none;
  }

  @media (max-width: 768px) {
    .product-grid-view {
      display: none;
    }
    .product-swiper {
      display: block;
    }
  }

  /* DESKTOP ZOOM */
  .zoom-container {
    position: relative;
    overflow: hidden;
    cursor: zoom-in;
  }

  .zoom-inner img {
    width: 100%;
    transition: transform 0.3s ease;
    transform-origin: center center;
  }

  .zoom-container.zoomed img {
    transform: scale(2);
    cursor: zoom-out;
  }

  /* ZOOM BUTTON (DESKTOP ONLY) */
  .zoom-toggle {
    position: absolute;
    bottom: 10px;
    right: 10px;
    background: #fff;
    border: none;
    padding: 6px;
    border-radius: 50%;
    cursor: pointer;
    z-index: 2;
  }

  /* MOBILE SWIPER */
  .product-swiper {
    width: 100%;
    height: 100%;
  }

  .swiper-slide {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ✅ FIX: Do NOT set touch-action: none here — Swiper handles it internally */
  .swiper-zoom-container {
    width: 100%;
    height: 100%;
    /* Removed touch-action: none — this was blocking pinch zoom */
  }

  .swiper-zoom-container img {
    width: 100%;
    height: auto;
    object-fit: contain;
    /* ✅ Prevent long-press save dialog interfering with drag */
    pointer-events: none;
    user-select: none;
    -webkit-user-select: none;
  }
</style>

<div class="custom-product-gallery">
  <!-- DESKTOP GRID -->
  <div class="product-grid-view">
    {% for media in product.media %}
      {% if media.media_type == 'image' %}
        <div class="grid-item">
          <div class="zoom-container">
            <div class="zoom-inner">
              <img
                src="{{ media.preview_image | image_url: width: 1200 }}"
                alt="{{ media.alt | escape }}"
              >
            </div>
            <button class="zoom-toggle">🔍</button>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>

  <!-- MOBILE SWIPER -->
  <div class="swiper product-swiper">
    <div class="swiper-wrapper">
      {% for media in product.media %}
        {% if media.media_type == 'image' %}
          <div class="swiper-slide">
            <div class="swiper-zoom-container">
              <img
                src="{{ media.preview_image | image_url: width: 2000 }}"
                alt="{{ media.alt | escape }}"
                draggable="false"
              >
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="swiper-button-next"></div>
    <div class="swiper-button-prev"></div>
  </div>
</div>

<!-- ✅ Use the BUNDLE — includes Zoom + Navigation modules pre-registered -->
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    /* ✅ SWIPER INIT */
    const swiper = new Swiper('.product-swiper', {
      slidesPerView: 1,
      spaceBetween: 10,

      // ✅ Zoom module config
      zoom: {
        maxRatio: 4,
        minRatio: 1,
        toggle: true, // double-tap to zoom
      },

      // ✅ These are correct — keep them
      simulateTouch: true,
      allowTouchMove: true,
      grabCursor: true,

      // ✅ FIX: Do NOT set touchStartPreventDefault: false
      // That causes Swiper to miss touch events on some browsers
      // Remove passiveListeners: false too — Swiper manages this internally

      navigation: {
        nextEl: '.swiper-button-next',
        prevEl: '.swiper-button-prev',
      },
    });

    /* ✅ DESKTOP CLICK ZOOM */
    document.querySelectorAll('.zoom-toggle').forEach((btn) => {
      btn.addEventListener('click', function () {
        const container = this.closest('.zoom-container');
        if (container) {
          container.classList.toggle('zoomed');
        }
      });
    });

    /* ✅ OPTIONAL: Click on image also toggles desktop zoom */
    document.querySelectorAll('.zoom-container').forEach((container) => {
      container.addEventListener('click', function (e) {
        if (!e.target.closest('.zoom-toggle')) {
          this.classList.toggle('zoomed');
        }
      });
    });
  });
</script>
