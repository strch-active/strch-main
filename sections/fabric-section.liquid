<section class="two-image-overlay">
  <div class="two-image-container">
    <!-- Left Image -->
    <div class="image-left">
      {% if section.settings.left_image != blank %}
        <img
          src="{{ section.settings.left_image | image_url: width: 1200 }}"
          alt="{{ section.settings.left_image.alt }}"
          width=""
          height=""
          loading="lazy"
        >
      {% endif %}
    </div>

    <!-- Right Image -->
    <div class="image-right">
      {% if section.settings.right_image != blank %}
        <img
          src="{{ section.settings.right_image | image_url: width: 1200 }}"
          alt="{{ section.settings.right_image.alt }}"
          width=""
          height=""
          loading="lazy"
        >
      {% endif %}

      <!-- Overlay Content -->
      <div class="overlay-content">
        {% if section.settings.heading != blank %}
          <h2>{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.subheading != blank %}
          <p>{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<style>
  .two-image-container {
    display: flex;
    width: 100%;
  }

  .image-left,
  .image-right {
    position: relative;
    width: 50%;
  }

  .image-left img,
  .image-right img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Overlay */

  .overlay-content {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: rgba(181, 214, 108, 0.6);
    padding: 40px;
    text-align: center;
    width: 90%;
    height: 90%;
    max-width: 90%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
  }

  .overlay-content h2 {
    font-size: 32px;
    letter-spacing: 3px;
    margin-bottom: 10px;
  }

  .overlay-content p {
    font-size: 18px;
    letter-spacing: 2px;
    color: #000;
    margin: 0;
  }

  /* Responsive */

  @media (max-width: 768px) {
    .two-image-container {
      flex-direction: column;
    }

    .image-left,
    .image-right {
      width: 100%;
    }

    .overlay-content {
      padding: 25px;
    }
  }
</style>

{% schema %}
{
  "name": "Two Image Overlay",
  "settings": [
    {
      "type": "image_picker",
      "id": "left_image",
      "label": "Left Image"
    },
    {
      "type": "image_picker",
      "id": "right_image",
      "label": "Right Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Overlay Heading",
      "default": "NYLON ENGINEERED ACTIVEWEAR"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Overlay Subheading",
      "default": "Softest Fabric for your hardest workouts"
    }
  ],
  "presets": [
    {
      "name": "Two Image Overlay"
    }
  ]
}
{% endschema %}
